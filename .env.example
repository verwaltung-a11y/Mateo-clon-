# --- Server ---
PORT=3000
# Öffentliche URL (für den Meta-Webhook), z.B. https://chat.ihre-firma.de
PUBLIC_URL=https://chat.example.de
# Zufälliger, langer Wert – signiert die Login-Cookies
SESSION_SECRET=bitte-aendern-langer-zufaelliger-wert
DB_FILE=./data/kundendialog.db

# --- WhatsApp Business Cloud API (Meta) ---
# Permanentes System-User-Token aus dem Meta Business Manager
WHATSAPP_TOKEN=
# App-Secret der Meta-App (zur Prüfung der Webhook-Signatur)
WHATSAPP_APP_SECRET=
# Frei wählbar, muss identisch im Meta-Webhook-Setup eingetragen werden
WHATSAPP_VERIFY_TOKEN=bitte-aendern
WHATSAPP_API_VERSION=v23.0
# true = nichts wird wirklich gesendet, nur protokolliert (zum Testen!)
DRY_RUN=true

# --- Standard-Ländervorwahl für Telefonnummern aus AkuWin ---
DEFAULT_COUNTRY_CODE=49
TZ=Europe/Berlin
